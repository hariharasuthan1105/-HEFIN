# ==========================================
# HEFIN 3.0 — Root .gitignore
# ==========================================

# --- Node & Dependencies ---
node_modules/
**/node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
.pnpm-store/

# --- Angular & Frontend Compiled Output ---
dist/
**/dist/
tmp/
**/tmp/
out-tsc/
**/out-tsc/
bazel-out/
.angular/
**/.angular/
.sass-cache/
**/.sass-cache/

# --- Test Artifacts & Playwright ---
test-results/
**/test-results/
playwright-report/
**/playwright-report/
blob-report/
**/blob-report/
playwright/.cache/
**/playwright/.cache/
.nyc_output/
coverage/
**/coverage/

# --- Environment Secrets & Credentials ---
.env
.env.*
!.env.example
*.pem
*.key
*.crt
*.pfx
*.p12
credentials.json
client_secret*.json

# --- Python & Virtual Environments (Django / FastAPI future) ---
__pycache__/
**/__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
eggs/
.eggs/
parts/
bin/
var/
sdist/
*.egg-info/
.installed.cfg
*.egg
.pytest_cache/
**/.pytest_cache/
.coverage
.coverage.*
.tox/
.nox/
venv/
.venv/
env/
.env/
ENV/
*.sqlite3
staticfiles/
backend/staticfiles/

# --- Blender & 3D Temporary Files ---
*.blend1
*.blend2
*.blend3
*.blend@
*.tmp
blender.zip
blender-*/
blender/

# --- Operating System & Editor Files ---
.DS_Store
.DS_Store?
._*
Thumbs.db
ehthumbs.db
[Dd]esktop.ini
.idea/
*.swp
*.swo
*.sublime-workspace

# --- VS Code (preserve shared configuration, ignore local state) ---
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
.history/
