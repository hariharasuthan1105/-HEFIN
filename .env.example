# ==============================================================================
# HEFIN 3.0 — Environment Configuration Template (.env.example)
# DO NOT COMMIT SECRETS OR SENSITIVE PRODUCTION CREDENTIALS
# ==============================================================================

# ------------------------------------------------------------------------------
# Django Backend Configuration (backend/)
# ------------------------------------------------------------------------------
# Set to False in production
DJANGO_DEBUG=True

# In development, a random key is generated automatically if left empty.
# In production, set a cryptographically secure 50+ character string.
DJANGO_SECRET_KEY=development-insecure-secret-key-do-not-use-in-production

# Comma-separated list of allowed hostnames
ALLOWED_HOSTS=127.0.0.1,localhost

# Comma-separated list of CORS origins for frontend dev server
CORS_ALLOWED_ORIGINS=http://localhost:4200,http://127.0.0.1:4200,http://localhost:4201,http://127.0.0.1:4201

# ------------------------------------------------------------------------------
# Database Configuration
# ------------------------------------------------------------------------------
# By default, when no PostgreSQL environment variables are provided,
# the backend uses SQLite (backend/db.sqlite3) for frictionless local setup.
#
# To use PostgreSQL, provide either DATABASE_URL or the DB_* variables:
# DATABASE_URL=postgres://hefin_user:hefin_password@localhost:5432/hefin_db
#
# Alternatively:
# DB_NAME=hefin_db
# DB_USER=hefin_user
# DB_PASSWORD=hefin_password
# DB_HOST=localhost
# DB_PORT=5432

# ------------------------------------------------------------------------------
# Angular Frontend Configuration (frontend/)
# ------------------------------------------------------------------------------
# Django REST API Base URL
HEFIN_API_BASE_URL=http://127.0.0.1:8000/api/v1

# Frontend environment mode (development / production)
HEFIN_ENVIRONMENT=development

# Demo mode toggle (true = displays simulated healthcare banners and allows synthetic demo switching)
HEFIN_DEMO_MODE=true
